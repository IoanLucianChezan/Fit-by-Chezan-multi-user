# Server
PORT=3000
NODE_ENV=development

# Baza de date Postgres (ex: Neon, gratuit, fara expirare) - connection string complet
# Format: postgresql://user:parola@host/baza?sslmode=require
DATABASE_URL=

# Secret pentru semnarea sesiunilor (JWT). Genereaza unul random, de ex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Contul de admin este creat automat la primul start daca nu exista deja niciun admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Limita AI/zi primita automat de userii care isi creeaza singuri cont (self-service)
DEFAULT_USER_AI_LIMIT=20

# Chei AI (server-side, niciodata trimise catre browser)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_MODEL_FALLBACK=gemma-4-31b

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
