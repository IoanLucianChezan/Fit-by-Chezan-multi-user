# Server
PORT=3000
NODE_ENV=development

# Secret pentru semnarea sesiunilor (JWT). Genereaza unul random, de ex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Contul de admin este creat automat la primul start daca nu exista deja niciun admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Chei AI (server-side, niciodata trimise catre browser)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_MODEL_FALLBACK=gemma-4-31b

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
